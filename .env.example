# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://novatip:novatip@localhost:5432/novatip

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Stellar / Soroban ─────────────────────────────────────────────────────────
# testnet | mainnet | local
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed tip_splitter contract ID
TIP_SPLITTER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract ID
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Ledger to start indexing from (set to current ledger on first deploy)
INDEXER_START_LEDGER=0
# Timeout for Soroban RPC calls the indexer makes, e.g. getLatestLedger (ms)
INDEXER_RPC_TIMEOUT_MS=5000
# How often the indexer polls Soroban RPC for new TipReceived events (ms)
INDEXER_POLL_INTERVAL_MS=6000
# Max TipReceived events fetched from Soroban RPC per poll iteration
INDEXER_POLL_LIMIT=200
# Days unowned tips (no creatorId) are kept before pruning; 0 disables pruning
UNOWNED_TIP_RETENTION_DAYS=90

# ── Rate limits ───────────────────────────────────────────────────────────────
# Server-wide budget for every route not covered by a dedicated limiter below.
# RATE_LIMIT_WINDOW takes @fastify/rate-limit's own format, e.g. "1 minute" or
# a millisecond count.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Per-IP cap on POST /auth/challenge, req/min. Tighter than the shared global
# budget above — that route is unauthenticated, so a single caller could
# otherwise mint nonces for arbitrary wallet addresses.
AUTH_CHALLENGE_RATE_LIMIT=5
# Per-IP cap on POST /auth/verify, req/min; verifies a Stellar signature.
AUTH_VERIFY_RATE_LIMIT=5
# Per-IP cap on the QR endpoints, req/min. QR generation is CPU-heavy and
# public, so the shared global budget is far too permissive here.
QR_RATE_LIMIT=10
# Per-IP caps on GET /resolve/:slug and GET /public/:slug/recent, req/min. The
# tip page hits both on every view, so each gets its own bucket rather than
# draining the shared global budget; keep their sum below RATE_LIMIT_MAX.
RESOLVE_RATE_LIMIT=30
PUBLIC_RECENT_RATE_LIMIT=30

# Per-user cap on CSV export, req/min. Each call streams entire tip history.
CSV_EXPORT_RATE_LIMIT=5

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Generate a unique 32-byte key with: openssl rand -hex 32
# Required in production; changing it makes stored webhook secrets unreadable.
WEBHOOK_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Allow private webhook destinations for local development only (default: false).
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Most webhooks one creator may register. Every enabled endpoint is delivered
# to on every indexed tip, so this bounds the outbound work one tip can cause.
# Set to 0 to remove the cap.
MAX_WEBHOOKS_PER_CREATOR=5

# Delivery limits. Slow endpoints can be accommodated by raising WEBHOOK_TIMEOUT_MS.
# Maximum number of webhook HTTP requests in flight across the process.
WEBHOOK_DELIVERY_CONCURRENCY=10
# Response body excerpts are capped by WEBHOOK_MAX_BODY_SIZE (bytes).
# Stored delivery payload records are capped by WEBHOOK_MAX_PAYLOAD_SIZE (bytes).
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_BODY_SIZE=1024
WEBHOOK_MAX_PAYLOAD_SIZE=2048

# ── Webhook delivery retention ────────────────────────────────────────────────
# Delivery rows are pruned on a schedule. Set a window to 0 to keep that class
# forever. Failures are kept longer than successes because they are what gets
# debugged.
WEBHOOK_DELIVERY_RETENTION_DAYS=30
WEBHOOK_DELIVERY_FAILURE_RETENTION_DAYS=90
# Rows deleted per statement, so a large backlog never locks the table
WEBHOOK_DELIVERY_PRUNE_BATCH_SIZE=500
WEBHOOK_DELIVERY_PRUNE_INTERVAL_MINUTES=60

# ── Notification retention ────────────────────────────────────────────────────
# Notification rows are pruned on a schedule. Set to 0 to keep them forever.
NOTIFICATION_RETENTION_DAYS=90

# ── Notifications (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=tips@novatip.xyz
# Individual tip emails per creator per UTC hour. Default: 10; 0 sends digests only.
EMAIL_MAX_PER_CREATOR_PER_HOUR=10

# ── Slugs ─────────────────────────────────────────────────────────────────────
# Days a released slug remains unavailable. Deleted creators have no owner
# exemption. Set to 0 to disable the hold.
CREATOR_SLUG_HOLD_DAYS=90

# Minimum days between slug renames. Prevents slug squatting: a creator who
# can rename freely can reserve unlimited slugs by renaming a → b → c → d,
# holding each for the full CREATOR_SLUG_HOLD_DAYS window. The first rename
# after claiming has no cooldown; subsequent renames are rate-limited. Set
# to 0 to allow unlimited renames.
CREATOR_SLUG_RENAME_COOLDOWN_DAYS=0

# Days before an abandoned sign-in placeholder (still on its auto-generated
# user_xxxxxxxx slug, with no tips, webhooks, notifications or released
# slugs) becomes eligible for deletion. Set to 0 to keep every placeholder
# forever.
PLACEHOLDER_CREATOR_RETENTION_DAYS=30
# Rows deleted per statement, so a large backlog never locks the table.
PLACEHOLDER_CREATOR_PRUNE_BATCH_SIZE=500
PLACEHOLDER_CREATOR_PRUNE_INTERVAL_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Comma-separated origins allowed through CORS in production (e.g. preview
# deployments). Default: just APP_BASE_URL. Ignored outside production,
# where any origin is allowed. Commented out below since there is no single
# literal default to uncomment — set it only to add origins beyond APP_BASE_URL.
# CORS_ALLOWED_ORIGINS=https://app.novatip.xyz,https://preview-123.novatip.pages.dev

# ── Proxy & Timeouts ──────────────────────────────────────────────────────────
# Number of proxy hops to trust (e.g. 1 for load balancer). When > 0, request.ip
# comes from X-Forwarded-For. Off by default; enabling without a proxy lets
# clients spoof their address.
TRUST_PROXY=0

# Request timeout: how long to wait for a complete request body (milliseconds)
REQUEST_TIMEOUT_MS=10000

# Connection timeout: idle connection limit (milliseconds)
CONNECTION_TIMEOUT_MS=60000

# ── Metrics ───────────────────────────────────────────────────────────────────
# Serve Prometheus metrics at GET /metrics. Off by default.
METRICS_ENABLED=false
# Bearer token /metrics requires. Leave empty only if the server is bound to
# an address reachable solely by your monitoring infrastructure.
METRICS_TOKEN=
